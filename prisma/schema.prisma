generator client {
  provider = "prisma-client-js"
  output = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id   Int    @id @default(autoincrement())
  name String @unique
  models Model[]
}

model Model {
  id      Int    @id @default(autoincrement())
  name    String
  brandId Int
  brand   Brand @relation(fields: [brandId], references: [id])
  cars    Car[]
}

model Car {
  id       Int       @id @default(autoincrement())
  title    String
  km       Int
  color    String
  modelId  Int
  model    Model   @relation(fields: [modelId], references: [id])
  features Feature[]
}

model Feature {
  id   Int    @id @default(autoincrement())
  name String @unique
  cars Car[]
}